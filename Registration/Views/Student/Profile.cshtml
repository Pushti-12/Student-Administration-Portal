@{
    ViewData["Title"] = "My Profile";
}

<div class="student-profile-page">

    <div class="page-header">

        <div>

            <span class="page-kicker">
                MY ACADEMICS
            </span>

            <h1>
                My Profile
            </h1>

            <p>
                View and update your personal and academic information.
            </p>

        </div>

    </div>


    <div id="profileMessage"
         class="student-profile-message">
    </div>


    <section class="student-profile-card">

        <!-- =========================
             PROFILE IMAGE SECTION
             ========================= -->

        <div class="student-profile-image-section">

            <div id="profileImageContainer"
                 class="student-profile-avatar">

                S

            </div>


            <div class="student-profile-image-info">

                <h2 id="profileDisplayName">
                    Student
                </h2>

                <p>
                    Upload your profile picture.
                </p>


                <label for="profileImageInput"
                       class="student-upload-button">

                    📷 Change Profile Picture

                </label>


                <input type="file"
                       id="profileImageInput"
                       accept="image/jpeg,image/png,image/webp" />

            </div>

        </div>


        <!-- =========================
             PROFILE FORM
             ========================= -->

        <form id="studentProfileForm">

            <div class="student-profile-grid">


                <!-- STUDENT ID -->

                <div class="student-form-group">

                    <label for="studentIdInput">
                        Student ID
                    </label>

                    <input type="text"
                           id="studentIdInput"
                           readonly />

                    <small>
                        Student ID cannot be changed.
                    </small>

                </div>


                <!-- NAME -->

                <div class="student-form-group">

                    <label for="studentName">
                        Name
                    </label>

                    <input type="text"
                           id="studentName"
                           required />

                </div>


                <!-- EMAIL -->

                <div class="student-form-group">

                    <label for="studentEmail">
                        Email
                    </label>

                    <input type="email"
                           id="studentEmail"
                           required />

                </div>


                <!-- PHONE -->

                <div class="student-form-group">

                    <label for="studentPhone">
                        Phone
                    </label>

                    <input type="text"
                           id="studentPhone"
                           maxlength="10"
                           pattern="[0-9]{10}"
                           required />

                    <small>
                        Enter a valid 10-digit phone number.
                    </small>

                </div>


                <!-- ADDRESS -->

                <div class="student-form-group student-full-width">

                    <label for="studentAddress">
                        Address
                    </label>

                    <input type="text"
                           id="studentAddress"
                           required />

                </div>


                <!-- COURSE -->

                <div class="student-form-group">

                    <label for="studentCourse">
                        Course
                    </label>

                    <input type="text"
                           id="studentCourse"
                           readonly />

                    <small>
                        Course details are managed by the administration.
                    </small>

                </div>


                <!-- ROLE -->

                <div class="student-form-group">

                    <label for="studentRole">
                        Role
                    </label>

                    <input type="text"
                           id="studentRole"
                           value="STUDENT"
                           readonly />

                </div>


            </div>


            <!-- =========================
                 ACTIONS
                 ========================= -->

            <div class="student-profile-actions">

                <button type="submit"
                        id="saveProfileButton">

                    Save Changes

                </button>

            </div>

        </form>

    </section>

</div>


<style>

    .student-profile-page {
        padding: 30px;
        background: #f8fafc;
        min-height: 100%;
    }


        .student-profile-page .page-header {
            margin-bottom: 25px;
        }


            .student-profile-page .page-header h1 {
                margin: 0;
            }


    .student-profile-card {
        max-width: 900px;
        margin: 0 auto;
        background: white;
        border-radius: 16px;
        padding: 30px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
    }


    .student-profile-image-section {
        display: flex;
        align-items: center;
        gap: 25px;
        padding-bottom: 25px;
        margin-bottom: 25px;
        border-bottom: 1px solid #e5e7eb;
    }


    .student-profile-avatar {
        width: 120px;
        height: 120px;
        min-width: 120px;
        border-radius: 50%;
        background: #4f46e5;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        font-weight: 700;
        overflow: hidden;
    }


    .student-profile-image {
        width: 120px;
        height: 120px;
        object-fit: cover;
        border-radius: 50%;
    }


    .student-profile-image-info h2 {
        margin: 0 0 6px;
        color: #111827;
    }


    .student-profile-image-info p {
        color: #6b7280;
        margin-bottom: 14px;
    }


    #profileImageInput {
        display: none;
    }


    .student-upload-button {
        display: inline-block;
        padding: 9px 15px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        color: #374151;
        background: white;
    }


        .student-upload-button:hover {
            background: #f3f4f6;
        }


    .student-profile-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
    }


    .student-form-group {
        display: flex;
        flex-direction: column;
    }


        .student-form-group label {
            margin-bottom: 7px;
            font-size: 14px;
            font-weight: 600;
            color: #374151;
        }


        .student-form-group input {
            height: 44px;
            padding: 0 12px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 14px;
            outline: none;
            box-sizing: border-box;
        }


            .student-form-group input:focus {
                border-color: #4f46e5;
            }


            .student-form-group input[readonly] {
                background: #f3f4f6;
                color: #6b7280;
            }


        .student-form-group small {
            margin-top: 5px;
            color: #9ca3af;
            font-size: 11px;
        }


    .student-full-width {
        grid-column: 1 / -1;
    }


    .student-profile-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #e5e7eb;
    }


    #saveProfileButton {
        border: none;
        border-radius: 8px;
        padding: 11px 22px;
        background: #4f46e5;
        color: white;
        font-weight: 600;
        cursor: pointer;
    }


        #saveProfileButton:hover {
            background: #4338ca;
        }


        #saveProfileButton:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }


    .student-profile-message {
        display: none;
        padding: 12px 15px;
        margin-bottom: 20px;
        border-radius: 8px;
    }


        .student-profile-message.success {
            display: block;
            background: #dcfce7;
            color: #166534;
        }


        .student-profile-message.error {
            display: block;
            background: #fee2e2;
            color: #991b1b;
        }


    @@media (max-width: 700px) {

        .student-profile-page {
            padding: 20px;
        }

        .student-profile-card {
            padding: 20px;
        }

        .student-profile-image-section {
            align-items: flex-start;
        }

        .student-profile-grid {
            grid-template-columns: 1fr;
        }

        .student-full-width {
            grid-column: auto;
        }
    }

</style>


<script>

    const studentProfileToken =
        localStorage.getItem("jwtToken");


    let currentStudent = null;

    let selectedProfileImage = null;


    const profileForm =
        document.getElementById(
            "studentProfileForm"
        );


    const nameInput =
        document.getElementById(
            "studentName"
        );


    const emailInput =
        document.getElementById(
            "studentEmail"
        );


    const phoneInput =
        document.getElementById(
            "studentPhone"
        );


    const addressInput =
        document.getElementById(
            "studentAddress"
        );


    const studentIdInput =
        document.getElementById(
            "studentIdInput"
        );


    const studentCourseInput =
        document.getElementById(
            "studentCourse"
        );


    const studentRoleInput =
        document.getElementById(
            "studentRole"
        );


    const profileImageInput =
        document.getElementById(
            "profileImageInput"
        );


    const profileImageContainer =
        document.getElementById(
            "profileImageContainer"
        );


    const profileDisplayName =
        document.getElementById(
            "profileDisplayName"
        );


    const saveProfileButton =
        document.getElementById(
            "saveProfileButton"
        );


    const profileMessage =
        document.getElementById(
            "profileMessage"
        );


    // ==========================================
    // MESSAGE
    // ==========================================

    function showMessage(message, type) {

        profileMessage.textContent =
            message;

        profileMessage.className =
            "student-profile-message " +
            type;

        profileMessage.style.display =
            "block";


        setTimeout(function() {

            profileMessage.style.display =
                "none";

        }, 4000);

    }


    // ==========================================
    // GET INITIAL
    // ==========================================

    function getInitial(name) {

        if (
            !name ||
            String(name).trim() === ""
        ) {
            return "S";
        }


        return String(name)
            .trim()
            .charAt(0)
            .toUpperCase();

    }


    // ==========================================
    // DISPLAY PROFILE IMAGE
    // ==========================================

    function displayProfileImage(
        image,
        name
    ) {

        if (
            !image ||
            String(image).trim() === ""
        ) {

            profileImageContainer.className =
                "student-profile-avatar";

            profileImageContainer.textContent =
                getInitial(name);

            return;
        }


        profileImageContainer.className =
            "student-profile-avatar";

        profileImageContainer.innerHTML =
            "";


        const img =
            document.createElement("img");


        img.src =
            image;


        img.alt =
            "Student Profile";


        img.className =
            "student-profile-image";


        img.onerror =
            function() {

                profileImageContainer.innerHTML =
                    getInitial(name);

            };


        profileImageContainer.appendChild(
            img
        );

    }


    // ==========================================
    // LOAD COURSE DETAILS
    // ==========================================

    async function loadCourseDetails(
        courseId
    ) {

        if (!courseId) {

            studentCourseInput.value =
                "Not available";

            return;

        }


        try {

            const response =
                await fetch(
                    "/api/courses",
                    {
                        headers: {
                            "Authorization":
                                "Bearer " +
                                studentProfileToken
                        }
                    }
                );


            if (!response.ok) {

                studentCourseInput.value =
                    "Not available";

                return;

            }


            const courses =
                await response.json();


            const course =
                courses.find(
                    function(c) {

                        return Number(c.id) ===
                            Number(courseId);

                    }
                );


            if (course) {

                studentCourseInput.value =
                    course.courseName +
                    " (" +
                    course.courseCode +
                    ")";

            }
            else {

                studentCourseInput.value =
                    "Not available";

            }

        }
        catch (error) {

            console.error(
                "Unable to load course:",
                error
            );


            studentCourseInput.value =
                "Not available";

        }

    }


    // ==========================================
    // LOAD PROFILE
    // ==========================================

    async function loadProfile() {

        if (!studentProfileToken) {

            window.location.href =
                "/Auth/Login";

            return;

        }


        try {

            const response =
                await fetch(
                    "/api/students/me",
                    {
                        method: "GET",

                        headers: {
                            "Authorization":
                                "Bearer " +
                                studentProfileToken
                        }
                    }
                );


            if (
                response.status === 401 ||
                response.status === 403
            ) {

                localStorage.removeItem(
                    "jwtToken"
                );

                localStorage.removeItem(
                    "loggedInUser"
                );

                window.location.href =
                    "/Auth/Login";

                return;

            }


            if (!response.ok) {

                throw new Error(
                    "Unable to load student profile."
                );

            }


            currentStudent =
                await response.json();


            // Keep existing student ID storage.

            localStorage.setItem(
                "studentId",
                currentStudent.id
            );


            nameInput.value =
                currentStudent.name || "";


            emailInput.value =
                currentStudent.email || "";


            phoneInput.value =
                currentStudent.phone || "";


            addressInput.value =
                currentStudent.address || "";


            studentIdInput.value =
                currentStudent.studentId || "";


            studentRoleInput.value =
                "STUDENT";


            profileDisplayName.textContent =
                currentStudent.name ||
                "Student";


            displayProfileImage(
                currentStudent.profileImage,
                currentStudent.name
            );


            await loadCourseDetails(
                currentStudent.courseId
            );

        }
        catch (error) {

            console.error(
                "Profile loading error:",
                error
            );


            showMessage(
                error.message ||
                "Unable to load profile.",
                "error"
            );

        }

    }


    // ==========================================
    // IMAGE SELECTION
    // ==========================================

    profileImageInput.addEventListener(
        "change",
        function(event) {

            const file =
                event.target.files[0];


            if (!file) {
                return;
            }


            if (
                file.size >
                2 * 1024 * 1024
            ) {

                showMessage(
                    "Profile image must be smaller than 2 MB.",
                    "error"
                );


                profileImageInput.value =
                    "";


                return;

            }


            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];


            if (
                !allowedTypes.includes(
                    file.type
                )
            ) {

                showMessage(
                    "Please select a JPG, PNG or WEBP image.",
                    "error"
                );


                profileImageInput.value =
                    "";


                return;

            }


            const reader =
                new FileReader();


            reader.onload =
                function(eventResult) {

                    selectedProfileImage =
                        eventResult.target.result;


                    displayProfileImage(
                        selectedProfileImage,
                        nameInput.value
                    );

                };


            reader.readAsDataURL(file);

        }
    );


    // ==========================================
    // SAVE PROFILE
    // ==========================================

    profileForm.addEventListener(
        "submit",
        async function(event) {

            event.preventDefault();


            const name =
                nameInput.value.trim();


            const email =
                emailInput.value.trim();


            const phone =
                phoneInput.value.trim();


            const address =
                addressInput.value.trim();


            if (!name) {

                showMessage(
                    "Please enter your name.",
                    "error"
                );

                return;

            }


            if (!email) {

                showMessage(
                    "Please enter your email.",
                    "error"
                );

                return;

            }


            if (
                !phone.match(
                    /^[0-9]{10}$/
                )
            ) {

                showMessage(
                    "Please enter a valid 10-digit phone number.",
                    "error"
                );

                return;

            }


            if (!address) {

                showMessage(
                    "Please enter your address.",
                    "error"
                );

                return;

            }


            if (
                !currentStudent ||
                !currentStudent.courseId
            ) {

                showMessage(
                    "Course information is not available.",
                    "error"
                );

                return;

            }


            saveProfileButton.disabled =
                true;


            saveProfileButton.textContent =
                "Saving...";


            try {

                let imageToSave =
                    null;


                if (selectedProfileImage) {

                    imageToSave =
                        selectedProfileImage;

                }
                else if (
                    currentStudent &&
                    currentStudent.profileImage
                ) {

                    imageToSave =
                        currentStudent.profileImage;

                }


                const requestData = {

                    name: name,

                    email: email,

                    phone: phone,

                    address: address,

                    courseId:
                        currentStudent.courseId,

                    profileImage:
                        imageToSave

                };


                const response =
                    await fetch(
                        "/api/students/me",
                        {
                            method: "PUT",

                            headers: {
                                "Authorization":
                                    "Bearer " +
                                    studentProfileToken,

                                "Content-Type":
                                    "application/json"
                            },

                            body:
                                JSON.stringify(
                                    requestData
                                )
                        }
                    );


                const result =
                    await response.json();


                if (!response.ok) {

                    throw new Error(
                        result.message ||
                        "Unable to update profile."
                    );

                }


                currentStudent =
                    result;


                selectedProfileImage =
                    null;


                profileImageInput.value =
                    "";


                nameInput.value =
                    result.name || "";


                emailInput.value =
                    result.email || "";


                phoneInput.value =
                    result.phone || "";


                addressInput.value =
                    result.address || "";


                studentIdInput.value =
                    result.studentId || "";


                profileDisplayName.textContent =
                    result.name ||
                    "Student";


                displayProfileImage(
                    result.profileImage,
                    result.name
                );


                await loadCourseDetails(
                    result.courseId
                );


                // =================================
                // UPDATE LOCAL STORAGE
                // =================================

                const storedUser =
                    localStorage.getItem(
                        "loggedInUser"
                    );


                if (storedUser) {

                    try {

                        const user =
                            JSON.parse(
                                storedUser
                            );


                        user.name =
                            result.name;


                        user.email =
                            result.email;


                        user.profileImage =
                            result.profileImage ||
                            "";


                        localStorage.setItem(
                            "loggedInUser",
                            JSON.stringify(user)
                        );

                    }
                    catch (storageError) {

                        console.error(
                            "Unable to update local storage:",
                            storageError
                        );

                    }

                }


                showMessage(
                    "Profile updated successfully.",
                    "success"
                );

            }
            catch (error) {

                console.error(
                    "Profile update error:",
                    error
                );


                showMessage(
                    error.message ||
                    "Unable to update profile.",
                    "error"
                );

            }
            finally {

                saveProfileButton.disabled =
                    false;


                saveProfileButton.textContent =
                    "Save Changes";

            }

        }
    );


    // ==========================================
    // START
    // ==========================================

    loadProfile();

</script>