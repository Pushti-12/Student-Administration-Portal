<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Admin Dashboard - Student Management System
    </title>

    <link rel="stylesheet"
          href="~/css/admin-dashboard.css" />

</head>


<body>

    <nav class="navbar">

        <div class="brand">
            <span class="brand-mark">🎓</span>
            Student Management System
        </div>

        <div class="admin-info">

            <div class="admin-profile-wrapper">

                <div class="admin-profile" id="profileToggle">

                    <span class="admin-avatar" id="adminAvatar">
                        A
                    </span>

                    <span class="admin-name" id="adminName">
                        Admin
                    </span>

                    <span class="profile-arrow">
                        ▾
                    </span>

                </div>

                <div class="profile-dropdown" id="profileDropdown">

                    <a href="/Admin/Profile"
                       class="profile-dropdown-item">

                        <span>👤</span>
                        <span>Profile</span>

                    </a>

                    <button type="button"
                            class="profile-dropdown-item logout-dropdown-item"
                            id="logoutBtn">

                        <span>🚪</span>
                        <span>Logout</span>

                    </button>

                </div>

            </div>

        </div>

    </nav>



    <main class="container">


        <div id="errorMessage"
             class="message">
        </div>


        <!-- =================================================
             WELCOME
             ================================================= -->

        <section class="welcome-section">

            <div>

                <span class="welcome-label">
                    ADMIN PANEL
                </span>

                <h1>
                    Admin Dashboard
                </h1>

                <p>
                    Manage students, teachers, courses,
                    attendance, marks and fees.
                </p>

            </div>


            <div class="welcome-badge">
                <span class="pulse-dot"></span>
                System Active
            </div>

        </section>



        <!-- =================================================
             STATISTICS
             ================================================= -->

        <section class="stats-grid">


            <!-- STUDENTS -->

            <div class="stat-card students-stat">

                <div class="stat-info">

                    <div class="stat-icon">
                        🎓
                    </div>

                    <span class="stat-title">
                        Total Students
                    </span>

                    <div class="stat-number"
                         id="studentCount">
                        0
                    </div>

                    <span class="stat-description">
                        Students registered
                    </span>

                </div>


                <div class="stat-decoration">
                    👥
                </div>

            </div>



            <!-- TEACHERS -->

            <div class="stat-card teachers-stat">

                <div class="stat-info">

                    <div class="stat-icon">
                        👨‍🏫
                    </div>

                    <span class="stat-title">
                        Total Teachers
                    </span>

                    <div class="stat-number"
                         id="teacherCount">
                        0
                    </div>

                    <span class="stat-description">
                        Faculty members
                    </span>

                </div>


                <div class="stat-decoration">
                    📚
                </div>

            </div>



            <!-- COURSES -->

            <div class="stat-card courses-stat">

                <div class="stat-info">

                    <div class="stat-icon">
                        📘
                    </div>

                    <span class="stat-title">
                        Total Courses
                    </span>

                    <div class="stat-number"
                         id="courseCount">
                        0
                    </div>

                    <span class="stat-description">
                        Active courses
                    </span>

                </div>


                <div class="stat-decoration">
                    ✦
                </div>

            </div>


        </section>



        <!-- =================================================
             MANAGEMENT
             ================================================= -->

        <div class="section-heading">

            <div>

                <span>
                    SYSTEM MANAGEMENT
                </span>

                <h2>
                    Management Modules
                </h2>

            </div>

            <p>
                Access and manage all core academic modules
            </p>

        </div>



        <section class="modules-grid">


            <!-- STUDENTS -->

            <div class="module-card">

                <div class="module-top">

                    <div class="module-icon students-icon">
                        🎓
                    </div>

                    <span class="module-number">
                        01
                    </span>

                </div>


                <h3>
                    Students
                </h3>

                <p>
                    Add, view, update and delete
                    student records.
                </p>


                <a href="/Admin/Students"
                   class="module-btn">

                    Manage Students

                    <span>
                        →
                    </span>

                </a>

            </div>



            <!-- TEACHERS -->

            <div class="module-card">

                <div class="module-top">

                    <div class="module-icon teachers-icon">
                        👨‍🏫
                    </div>

                    <span class="module-number">
                        02
                    </span>

                </div>


                <h3>
                    Teachers
                </h3>

                <p>
                    Add, view, update and delete
                    teacher records.
                </p>


                <a href="/Admin/Teachers"
                   class="module-btn">

                    Manage Teachers

                    <span>
                        →
                    </span>

                </a>

            </div>



            <!-- COURSES -->

            <div class="module-card">

                <div class="module-top">

                    <div class="module-icon courses-icon">
                        📚
                    </div>

                    <span class="module-number">
                        03
                    </span>

                </div>


                <h3>
                    Courses
                </h3>

                <p>
                    Manage courses and assign
                    teachers to courses.
                </p>


                <a href="/Admin/Courses"
                   class="module-btn">

                    Manage Courses

                    <span>
                        →
                    </span>

                </a>

            </div>



            <!-- ATTENDANCE -->

            <div class="module-card">

                <div class="module-top">

                    <div class="module-icon attendance-icon">
                        ✅
                    </div>

                    <span class="module-number">
                        04
                    </span>

                </div>


                <h3>
                    Attendance
                </h3>

                <p>
                    Mark and view student
                    attendance records.
                </p>


                <a href="/Admin/Attendance"
                   class="module-btn">

                    Manage Attendance

                    <span>
                        →
                    </span>

                </a>

            </div>



            <!-- MARKS -->

            <div class="module-card">

                <div class="module-top">

                    <div class="module-icon marks-icon">
                        📝
                    </div>

                    <span class="module-number">
                        05
                    </span>

                </div>


                <h3>
                    Marks & Results
                </h3>

                <p>
                    Add and view student marks
                    and performance.
                </p>


                <a href="/Admin/Marks"
                   class="module-btn">

                    Manage Marks

                    <span>
                        →
                    </span>

                </a>

            </div>



            <!-- FEES -->

            <div class="module-card">

                <div class="module-top">

                    <div class="module-icon fees-icon">
                        💳
                    </div>

                    <span class="module-number">
                        06
                    </span>

                </div>


                <h3>
                    Fees
                </h3>

                <p>
                    Add payments and manage
                    student fee status.
                </p>


                <a href="/Admin/Fees"
                   class="module-btn">

                    Manage Fees

                    <span>
                        →
                    </span>

                </a>

            </div>


        </section>


    </main>



    <script src="~/js/admin-dashboard.js"></script>

</body>

</html>