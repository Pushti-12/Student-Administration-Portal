<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width,initial-scale=1">

    <title>Fees - Admin</title>


    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f7fb;
            color: #1f2937;
        }

        .navbar {
            height: 70px;
            background: white;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 35px;
        }

        .brand {
            font-size: 22px;
            font-weight: 700;
            color: #2563eb;
        }

        .back {
            color: #374151;
            text-decoration: none;
            font-weight: 600;
        }

        .container {
            max-width: 1200px;
            margin: auto;
            padding: 35px;
        }

        .header {
            margin-bottom: 25px;
        }

        .header p {
            color: #6b7280;
            margin-top: 6px;
        }

        .card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        label {
            display: block;
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 6px;
        }

        input,
        select {
            width: 100%;
            padding: 10px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            outline: none;
            background: white;
        }

        input:focus,
        select:focus {
            border-color: #2563eb;
        }

        button {
            border: 0;
            padding: 10px 17px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
        }

        .save {
            background: #2563eb;
            color: white;
        }

        .save:hover {
            background: #1d4ed8;
        }

        .search-area {
            display: flex;
            gap: 10px;
            max-width: 550px;
        }

        .search-select {
            flex: 1;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 14px;
            border-bottom: 1px solid #e5e7eb;
            text-align: left;
        }

        th {
            background: #f9fafb;
        }

        .message {
            display: none;
            padding: 12px;
            margin-bottom: 20px;
            border-radius: 7px;
        }

        .success {
            background: #dcfce7;
            color: #166534;
        }

        .error {
            background: #fee2e2;
            color: #991b1b;
        }

        .empty-row {
            text-align: center;
            padding: 30px;
            color: #6b7280;
        }

        @@media(max-width:800px) {

            .grid {
                grid-template-columns: 1fr 1fr;
            }

        }

        @@media(max-width:500px) {

            .grid {
                grid-template-columns: 1fr;
            }

            .search-area {
                flex-direction: column;
                max-width: 100%;
            }

        }

    </style>

</head>


<body>

    <nav class="navbar">

        <div class="brand">
            Student Management System
        </div>

        <a href="/Admin/Dashboard"
           class="back">

            ← Dashboard

        </a>

    </nav>


    <main class="container">

        <div id="message"
             class="message">
        </div>


        <div class="header">

            <h1>
                Fee Management
            </h1>

            <p>
                Add payments and view student fee status.
            </p>

        </div>


        <!-- ========================= -->
        <!-- ADD PAYMENT -->
        <!-- ========================= -->

        <div class="card">

            <form id="form">

                <div class="grid">


                    <!-- STUDENT -->

                    <div>

                        <label>
                            Student
                        </label>

                        <select id="studentId"
                                required>

                            <option value="">
                                Loading students...
                            </option>

                        </select>

                    </div>


                    <!-- AMOUNT -->

                    <div>

                        <label>
                            Amount
                        </label>

                        <input type="number"
                               id="amount"
                               required
                               min="0"
                               step="0.01">

                    </div>


                    <!-- PAYMENT DATE -->

                    <div>

                        <label>
                            Payment Date
                        </label>

                        <input type="date"
                               id="paymentDate"
                               required>

                    </div>


                    <!-- STATUS -->

                    <div>

                        <label>
                            Status
                        </label>

                        <select id="status"
                                required>

                            <option value="PAID">
                                PAID
                            </option>

                            <option value="PENDING">
                                PENDING
                            </option>

                        </select>

                    </div>

                </div>


                <br>


                <button
                    type="submit"
                    class="save">

                    Add Payment

                </button>

            </form>

        </div>


        <!-- ========================= -->
        <!-- FEE STATUS -->
        <!-- ========================= -->

        <div class="card">

            <h2>
                Fee Status
            </h2>

            <br>


            <div class="search-area">

                <div class="search-select">

                    <label>
                        Select Student
                    </label>

                    <select id="searchStudent">

                        <option value="">
                            Select Student
                        </option>

                    </select>

                </div>


                <div style="display:flex;align-items:flex-end">

                    <button
                        type="button"
                        class="save"
                        onclick="loadFees()">

                        View

                    </button>

                </div>

            </div>


            <br>


            <table>

                <thead>

                    <tr>

                        <th>
                            Student
                        </th>

                        <th>
                            Amount
                        </th>

                        <th>
                            Payment Date
                        </th>

                        <th>
                            Status
                        </th>

                    </tr>

                </thead>


                <tbody id="body">
                </tbody>

            </table>

        </div>

    </main>


    <script>


        // =========================
        // AUTHENTICATION
        // =========================

        const token =
            localStorage.getItem(
                "jwtToken"
            );


        const user =
            JSON.parse(
                localStorage.getItem(
                    "loggedInUser"
                ) || "null"
            );


        if (
            !token ||
            !user ||
            user.role.toUpperCase() !== "ADMIN"
        ) {

            location.href = "/";

        }


        // =========================
        // GLOBAL DATA
        // =========================

        let students = [];


        // =========================
        // DEFAULT PAYMENT DATE
        // =========================

        document
            .getElementById("paymentDate")
            .valueAsDate = new Date();


        // =========================
        // LOAD STUDENTS
        // =========================

        async function loadStudents() {

            try {

                const response =
                    await fetch(
                        "/api/students",
                        {

                            method: "GET",

                            headers: {

                                "Authorization":
                                    `Bearer ${token}`,

                                "Content-Type":
                                    "application/json"

                            }

                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        "Unable to load students."
                    );

                }


                students =
                    await response.json();


                const studentDropdown =
                    document.getElementById(
                        "studentId"
                    );


                const searchDropdown =
                    document.getElementById(
                        "searchStudent"
                    );


                studentDropdown.innerHTML =
                    `
                    <option value="">
                        Select Student
                    </option>
                    `;


                searchDropdown.innerHTML =
                    `
                    <option value="">
                        Select Student
                    </option>
                    `;


                if (
                    !students ||
                    students.length === 0
                ) {

                    studentDropdown.innerHTML =
                        `
                        <option value="">
                            No students available
                        </option>
                        `;

                    searchDropdown.innerHTML =
                        `
                        <option value="">
                            No students available
                        </option>
                        `;

                    return;

                }


                students.forEach(
                    function (student) {

                        const option =
                            document.createElement(
                                "option"
                            );


                        option.value =
                            student.id;


                        option.textContent =
                            `${student.studentId} - ${student.name}`;


                        studentDropdown.appendChild(
                            option
                        );


                        const searchOption =
                            document.createElement(
                                "option"
                            );


                        searchOption.value =
                            student.id;


                        searchOption.textContent =
                            `${student.studentId} - ${student.name}`;


                        searchDropdown.appendChild(
                            searchOption
                        );

                    }
                );

            }
            catch (error) {

                console.error(
                    "Student loading error:",
                    error
                );


                show(
                    "Unable to load students.",
                    "error"
                );

            }

        }


        // =========================
        // GET STUDENT
        // =========================

        function getStudent(studentId) {

            return students.find(
                student =>
                    Number(student.id) ===
                    Number(studentId)
            );

        }


        // =========================
        // ADD PAYMENT
        // =========================

        document
            .getElementById("form")
            .addEventListener(
                "submit",
                async function (event) {

                    event.preventDefault();


                    const studentId =
                        Number(
                            document
                                .getElementById(
                                    "studentId"
                                )
                                .value
                        );


                    const amount =
                        Number(
                            document
                                .getElementById(
                                    "amount"
                                )
                                .value
                        );


                    if (!studentId) {

                        show(
                            "Please select a student.",
                            "error"
                        );

                        return;

                    }


                    if (
                        Number.isNaN(amount) ||
                        amount < 0
                    ) {

                        show(
                            "Please enter a valid amount.",
                            "error"
                        );

                        return;

                    }


                    const data = {

                        studentId:
                            studentId,

                        amount:
                            amount,

                        paymentDate:
                            document
                                .getElementById(
                                    "paymentDate"
                                )
                                .value,

                        status:
                            document
                                .getElementById(
                                    "status"
                                )
                                .value

                    };


                    try {

                        const response =
                            await fetch(
                                "/api/fees",
                                {

                                    method: "POST",

                                    headers: {

                                        "Authorization":
                                            `Bearer ${token}`,

                                        "Content-Type":
                                            "application/json"

                                    },

                                    body:
                                        JSON.stringify(
                                            data
                                        )

                                }
                            );


                        if (!response.ok) {

                            const errorText =
                                await response.text();


                            console.error(
                                "Fee API error:",
                                errorText
                            );


                            throw new Error(
                                errorText ||
                                "Unable to add fee payment."
                            );

                        }


                        show(
                            "Fee payment added successfully.",
                            "success"
                        );


                        document
                            .getElementById(
                                "searchStudent"
                            )
                            .value =
                            studentId;


                        await loadFees();


                        document
                            .getElementById(
                                "amount"
                            )
                            .value = "";

                    }
                    catch (error) {

                        console.error(
                            "Fee error:",
                            error
                        );


                        show(
                            "Unable to add fee payment.",
                            "error"
                        );

                    }

                }
            );


        // =========================
        // LOAD FEES
        // =========================

        async function loadFees() {

            const studentId =
                document
                    .getElementById(
                        "searchStudent"
                    )
                    .value;


            if (!studentId) {

                show(
                    "Please select a student.",
                    "error"
                );

                return;

            }


            try {

                const response =
                    await fetch(
                        `/api/fees/student/${studentId}`,
                        {

                            method: "GET",

                            headers: {

                                "Authorization":
                                    `Bearer ${token}`

                            }

                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        "Unable to load fee status."
                    );

                }


                const fees =
                    await response.json();


                const body =
                    document.getElementById(
                        "body"
                    );


                body.innerHTML = "";


                const student =
                    getStudent(
                        studentId
                    );


                if (
                    !fees ||
                    fees.length === 0
                ) {

                    body.innerHTML = `

                        <tr>

                            <td colspan="4"
                                class="empty-row">

                                No fee records found for
                                ${student
                                    ? `${student.studentId} - ${student.name}`
                                    : "selected student"}.

                            </td>

                        </tr>

                    `;

                    return;

                }


                fees.forEach(
                    function (fee) {

                        body.innerHTML += `

                            <tr>

                                <td>
                                    ${student
                                        ? `${student.studentId} - ${student.name}`
                                        : "N/A"}
                                </td>

                                <td>
                                    ₹ ${Number(
                                        fee.amount
                                    ).toFixed(2)}
                                </td>

                                <td>
                                    ${new Date(
                                        fee.paymentDate
                                    ).toLocaleDateString()}
                                </td>

                                <td>
                                    ${fee.status}
                                </td>

                            </tr>

                        `;

                    }
                );

            }
            catch (error) {

                console.error(
                    "Fee loading error:",
                    error
                );


                show(
                    "Unable to load fee status.",
                    "error"
                );

            }

        }


        // =========================
        // MESSAGE
        // =========================

        function show(
            text,
            type
        ) {

            const message =
                document.getElementById(
                    "message"
                );


            message.textContent =
                text;


            message.className =
                `message ${type}`;


            message.style.display =
                "block";


            setTimeout(
                function () {

                    message.style.display =
                        "none";

                },
                3000
            );

        }


        // =========================
        // INITIAL LOAD
        // =========================

        loadStudents();

    </script>

</body>
</html>