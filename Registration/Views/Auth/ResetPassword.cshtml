@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Student Management System - Reset Password
    </title>


    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }


            body {
                min-height: 100vh;
                font-family: "Segoe UI", Arial, sans-serif;
                background: #f5f7fb;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 25px;
            }


            .reset-wrapper {
                width: 100%;
                max-width: 1050px;
                min-height: 620px;
                background: #ffffff;
                border-radius: 20px;
                overflow: hidden;
                display: grid;
                grid-template-columns: 1.05fr 0.95fr;
                box-shadow: 0 15px 45px rgba(0, 0, 0, 0.10);
            }


            /* =========================
                       LEFT PANEL
                       ========================= */

            .brand-panel {
                background: linear-gradient( 145deg, #312e81, #4f46e5 );
                color: #ffffff;
                padding: 60px;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }


            .brand-icon {
                width: 70px;
                height: 70px;
                border-radius: 18px;
                background: rgba(255, 255, 255, 0.15);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 34px;
                margin-bottom: 28px;
            }


            .brand-panel h1 {
                font-size: 36px;
                line-height: 1.2;
                font-weight: 700;
                margin-bottom: 18px;
            }


            .brand-panel > p {
                max-width: 430px;
                color: #e0e7ff;
                font-size: 15px;
                line-height: 1.7;
            }


            /* =========================
                       FEATURES
                       ========================= */

            .features {
                margin-top: 35px;
            }


            .feature {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 17px;
                font-size: 14px;
                color: #f8fafc;
            }


            .feature-icon {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.15);
                display: flex;
                align-items: center;
                justify-content: center;
            }


            /* =========================
                       RIGHT PANEL
                       ========================= */

            .reset-panel {
                padding: 60px;
                display: flex;
                align-items: center;
                justify-content: center;
            }


            .reset-box {
                width: 100%;
                max-width: 380px;
            }


                .reset-box h2 {
                    font-size: 30px;
                    color: #111827;
                    margin-bottom: 8px;
                }


            .subtitle {
                color: #6b7280;
                font-size: 14px;
                line-height: 1.6;
                margin-bottom: 30px;
            }


            /* =========================
                       MESSAGE
                       ========================= */

            .message {
                display: none;
                padding: 12px 14px;
                border-radius: 9px;
                font-size: 14px;
                margin-bottom: 20px;
            }


            .error-message {
                color: #b91c1c;
                background: #fef2f2;
                border: 1px solid #fecaca;
            }


            .success-message {
                color: #15803d;
                background: #f0fdf4;
                border: 1px solid #bbf7d0;
            }


            /* =========================
                       FORM
                       ========================= */

            .form-group {
                margin-bottom: 21px;
            }


                .form-group label {
                    display: block;
                    color: #374151;
                    font-size: 14px;
                    font-weight: 600;
                    margin-bottom: 8px;
                }


                .form-group input {
                    width: 100%;
                    height: 49px;
                    border: 1px solid #d1d5db;
                    border-radius: 10px;
                    padding: 0 14px;
                    font-size: 15px;
                    color: #111827;
                    outline: none;
                    transition: 0.2s ease;
                }


                    .form-group input:focus {
                        border-color: #4f46e5;
                        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.10);
                    }


            /* =========================
                       BUTTON
                       ========================= */

            .reset-button {
                width: 100%;
                height: 50px;
                border: none;
                border-radius: 10px;
                background: #4f46e5;
                color: #ffffff;
                font-size: 16px;
                font-weight: 600;
                cursor: pointer;
                margin-top: 5px;
                transition: 0.2s ease;
            }


                .reset-button:hover {
                    background: #4338ca;
                }


                .reset-button:disabled {
                    opacity: 0.65;
                    cursor: not-allowed;
                }


            /* =========================
                       LOGIN LINK
                       ========================= */

            .login-link {
                text-align: center;
                margin-top: 25px;
                font-size: 14px;
            }


                .login-link a {
                    color: #4f46e5;
                    text-decoration: none;
                    font-weight: 600;
                }


                    .login-link a:hover {
                        text-decoration: underline;
                    }


            /* =========================
                       FOOTER
                       ========================= */

            .footer-text {
                text-align: center;
                margin-top: 28px;
                color: #9ca3af;
                font-size: 12px;
            }


            /* =========================
                       RESPONSIVE
                       ========================= */

            @@media (max-width: 768px) {

                .reset-wrapper {
                    grid-template-columns: 1fr;
                }

                .brand-panel {
                    padding: 40px 30px;
                }

                    .brand-panel h1 {
                        font-size: 29px;
                    }

                .features {
                    display: none;
                }

                .reset-panel {
                    padding: 40px 30px;
                }
            }

    </style>

</head>


<body>


    <div class="reset-wrapper">


        <!-- =========================
             BRAND PANEL
             ========================= -->

        <section class="brand-panel">

            <div class="brand-icon">
                🔐
            </div>


            <h1>
                Student Management System
            </h1>


            <p>
                Create a new password and securely
                regain access to your student,
                teacher or administrator account.
            </p>


            <div class="features">

                <div class="feature">

                    <span class="feature-icon">
                        ✓
                    </span>

                    <span>
                        Secure Password Reset
                    </span>

                </div>


                <div class="feature">

                    <span class="feature-icon">
                        ✓
                    </span>

                    <span>
                        Protected Account
                    </span>

                </div>


                <div class="feature">

                    <span class="feature-icon">
                        ✓
                    </span>

                    <span>
                        One-Time Reset Link
                    </span>

                </div>

            </div>

        </section>


        <!-- =========================
             RESET PASSWORD PANEL
             ========================= -->

        <section class="reset-panel">

            <div class="reset-box">


                <h2>
                    Reset Password
                </h2>


                <p class="subtitle">
                    Enter your new password below.
                </p>


                <!-- ERROR -->

                <div id="errorMessage"
                     class="message error-message">
                </div>


                <!-- SUCCESS -->

                <div id="successMessage"
                     class="message success-message">
                </div>


                <!-- FORM -->

                <form id="resetPasswordForm">


                    <div class="form-group">

                        <label for="newPassword">
                            New Password
                        </label>

                        <input type="password"
                               id="newPassword"
                               name="newPassword"
                               placeholder="Enter new password"
                               minlength="6"
                               autocomplete="new-password"
                               required />

                    </div>


                    <div class="form-group">

                        <label for="confirmPassword">
                            Confirm Password
                        </label>

                        <input type="password"
                               id="confirmPassword"
                               name="confirmPassword"
                               placeholder="Confirm new password"
                               minlength="6"
                               autocomplete="new-password"
                               required />

                    </div>


                    <button type="submit"
                            id="resetButton"
                            class="reset-button">

                        Reset Password

                    </button>


                </form>


                <!-- LOGIN -->

                <div class="login-link">

                    Remember your password?

                    <a href="/Auth/Login">
                        Login here
                    </a>

                </div>


                <div class="footer-text">
                    Student Management System
                </div>


            </div>

        </section>


    </div>


    <script>

            // ==========================================
            // GET TOKEN FROM EMAIL RESET LINK
            // ==========================================

            const urlParams =
                new URLSearchParams(
                    window.location.search
                );


            const token =
                urlParams.get("token");


            // ==========================================
            // ELEMENTS
            // ==========================================

            const resetPasswordForm =
                document.getElementById(
                    "resetPasswordForm"
                );


            const newPasswordInput =
                document.getElementById(
                    "newPassword"
                );


            const confirmPasswordInput =
                document.getElementById(
                    "confirmPassword"
                );


            const resetButton =
                document.getElementById(
                    "resetButton"
                );


            const errorMessage =
                document.getElementById(
                    "errorMessage"
                );


            const successMessage =
                document.getElementById(
                    "successMessage"
                );


            // ==========================================
            // MESSAGE FUNCTIONS
            // ==========================================

            function hideMessages() {

                errorMessage.style.display =
                    "none";

                successMessage.style.display =
                    "none";
            }


            function showError(message) {

                errorMessage.innerText =
                    message;

                errorMessage.style.display =
                    "block";
            }


            function showSuccess(message) {

                successMessage.innerText =
                    message;

                successMessage.style.display =
                    "block";
            }


            // ==========================================
            // CHECK TOKEN
            // ==========================================

            if (!token) {

                showError(
                    "Invalid password reset link."
                );

                resetButton.disabled = true;
            }


            // ==========================================
            // RESET PASSWORD
            // ==========================================

            resetPasswordForm.addEventListener(
                "submit",
                async function(event) {

                    event.preventDefault();


                    hideMessages();


                    // Token check

                    if (!token) {

                        showError(
                            "Invalid password reset link."
                        );

                        return;
                    }


                    const newPassword =
                        newPasswordInput.value;


                    const confirmPassword =
                        confirmPasswordInput.value;


                    // Password match

                    if (newPassword !== confirmPassword) {

                        showError(
                            "Passwords do not match."
                        );

                        return;
                    }


                    // Minimum length

                    if (newPassword.length < 6) {

                        showError(
                            "Password must be at least 6 characters long."
                        );

                        return;
                    }


                    resetButton.disabled = true;

                    resetButton.innerText =
                        "Resetting...";


                    try {

                        const response =
                            await fetch(
                                "/api/auth/reset-password",
                                {
                                    method: "POST",

                                    headers: {
                                        "Content-Type":
                                            "application/json"
                                    },

                                    body: JSON.stringify({

                                        token: token,

                                        newPassword:
                                            newPassword,

                                        confirmPassword:
                                            confirmPassword

                                    })
                                }
                            );


                        const data =
                            await response.json();


                        if (!response.ok) {

                            showError(
                                data.message ||
                                "Invalid or expired password reset link."
                            );

                            return;
                        }


                        showSuccess(
                            data.message ||
                            "Password has been reset successfully."
                        );


                        resetPasswordForm.reset();


                        // Disable form after successful reset

                        resetButton.disabled = true;


                    }
                    catch (error) {

                        console.error(
                            "Reset Password Error:",
                            error
                        );


                        showError(
                            "Something went wrong. Please try again."
                        );

                    }
                    finally {

                        if (
                            resetButton.innerText ===
                            "Resetting..."
                        ) {

                            resetButton.innerText =
                                "Reset Password";
                        }

                    }

                }
            );

    </script>


</body>

</html>